# Application / authentication
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-random-nextauth-secret
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=support@example.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Calendar
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=your-32-byte-base64-or-hex-key

# Email
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=Axiom <notifications@example.com>

# Web Push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@example.com

# Cron authentication. Use the same value in Vercel and an external scheduler.
CRON_SECRET=your-random-cron-secret

# Private Cloudflare R2 attachments
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=axiom-private
ATTACHMENT_PDF_SECURITY_MODE=reject_without_scanner
ATTACHMENT_PDF_BETA_USER_IDS=
ATTACHMENT_SCANNER_URL=
ATTACHMENT_SCANNER_TOKEN=

# Legacy OpenAI features
OPENAI_API_KEY=your-openai-api-key
OPENAI_TEXT_MODEL=gpt-4o
OPENAI_SPEECH_MODEL=whisper-1
AI_FEATURES_ENABLED=false
AI_VOICE_TO_TASK_ENABLED=true
AI_DESCRIPTION_GENERATOR_ENABLED=true
AI_DAILY_STANDUP_ENABLED=true
AI_BLOCKER_DETECTOR_ENABLED=true
AI_MAX_AUDIO_DURATION=300
AI_MAX_AUDIO_SIZE=26214400
AI_DAILY_REQUESTS_PER_USER=10
AI_MONTHLY_REQUESTS_PER_ORG=100

# Atomic AI quota. Enable only after the foundation migration/preflight passes.
AI_ATOMIC_QUOTA_ENABLED=false

# Groq chat provider (server-only)
GROQ_API_KEY=
GROQ_CHAT_MODEL=qwen/qwen3.8-27b

# Cloudflare Workers AI embeddings (dedicated least-privilege token; not R2 token)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
CLOUDFLARE_EMBEDDING_MODEL=@cf/baai/bge-m3

# Derived AI index. Keep both activation flags false until staging validation.
AI_INDEXING_ENABLED=false
AI_INDEX_BACKFILL_ENABLED=false
# One-shot exact Note job validation only; keep false outside an approved test.
AI_TARGETED_NOTE_INDEXING_ENABLED=false
AI_INDEX_VERSION=bge-m3-v1
AI_INDEX_BATCH_SIZE=8
# Fail-closed production beta scope. Jobs outside these source types and exact
# Process UUIDs are never leased by the indexing worker.
AI_INDEX_SOURCE_TYPES=task,note,process
AI_INDEX_PROJECT_IDS=
AI_RETRIEVAL_INDEX_VERSION=bge-m3-v1

# Streaming AI chat. Keep false until all four AI migrations and preflights pass.
AXIOM_AI_CHAT_ENABLED=false
# Read-only agent tools. Keep false until staging authorization/tool-loop tests pass.
AXIOM_AI_READ_TOOLS_ENABLED=false
AXIOM_AI_WRITE_TOOLS_ENABLED=false
# Controlled production beta. With beta mode enabled, both lists must match;
# empty lists authorize nobody. Use canonical database UUIDs, never email addresses.
AXIOM_AI_BETA_MODE_ENABLED=true
AXIOM_AI_BETA_USER_IDS=
AXIOM_AI_BETA_ORGANIZATION_IDS=
AI_CHAT_MAX_OUTPUT_TOKENS=2048
AI_CHAT_TIMEOUT_MS=50000
AI_CHAT_USER_CONCURRENCY=2
AI_CHAT_ORG_CONCURRENCY=20
AI_GROQ_TPM_ADMISSION_ENABLED=false
AI_GROQ_TPM_BUDGET=7200

# Billing
LEMONSQUEEZY_WEBHOOK_SECRET=your-lemonsqueezy-webhook-secret
LEMONSQUEEZY_API_KEY=your-lemonsqueezy-api-key
LEMONSQUEEZY_STORE_ID=your-store-id
LEMON_VARIANT_PRO_IDS=your-monthly-variant-id,your-yearly-variant-id
LEMON_VARIANT_TEAM_IDS=your-monthly-variant-id,your-yearly-variant-id
