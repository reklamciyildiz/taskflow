# Copy this file to .env.staging.local. The .local file is gitignored.
AXIOM_STAGING_ALLOW_WRITES=false
AXIOM_STAGING_SUPABASE_PROJECT_REF=your-staging-project-ref
# Percent-encoded URI from Supabase Connect. Prefer Session pooler if needed.
AXIOM_STAGING_DATABASE_URL=
AXIOM_STAGING_APPLY_CONFIRM=
AXIOM_STAGING_TEST_PASSWORD=

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-staging-only-random-secret
NEXT_PUBLIC_SUPABASE_URL=https://your-staging-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-staging-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-staging-secret-key

AXIOM_MOBILE_AUTH_ENABLED=false
MOBILE_AUTH_TOKEN_PEPPER=generate-a-staging-only-secret-at-least-32-characters
MOBILE_AUTH_ENCRYPTION_KEY=generate-a-separate-staging-only-secret-at-least-32-characters
MOBILE_AUTH_ALLOWED_ORIGINS=https://localhost
MOBILE_GOOGLE_CALLBACK_URL=https://your-staging-domain.example/api/mobile/auth/google/callback
MOBILE_AUTH_APP_LINK_URL=https://your-staging-domain.example/mobile/auth/callback

GROQ_API_KEY=your-groq-api-key
GROQ_CHAT_MODEL=qwen/qwen3.8-27b
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_AI_API_TOKEN=your-workers-ai-token
CLOUDFLARE_EMBEDDING_MODEL=@cf/baai/bge-m3
CRON_SECRET=generate-a-staging-only-cron-secret

AI_FEATURES_ENABLED=false
AI_ATOMIC_QUOTA_ENABLED=false
AI_INDEXING_ENABLED=false
AI_INDEX_BACKFILL_ENABLED=false
AXIOM_AI_CHAT_ENABLED=false
AXIOM_AI_BETA_MODE_ENABLED=true
AXIOM_AI_BETA_USER_IDS=20000000-0000-4000-8000-000000000001
AXIOM_AI_BETA_ORGANIZATION_IDS=10000000-0000-4000-8000-000000000001
AI_INDEX_VERSION=bge-m3-v1
AI_INDEX_BATCH_SIZE=8
AI_RETRIEVAL_INDEX_VERSION=bge-m3-v1
AI_CHAT_MAX_OUTPUT_TOKENS=2048
AI_CHAT_TIMEOUT_MS=50000
AI_CHAT_USER_CONCURRENCY=2
AI_CHAT_ORG_CONCURRENCY=20
